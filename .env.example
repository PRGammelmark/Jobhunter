MONGODB_URI=mongodb://localhost:27017/career-intelligence?replicaSet=rs0
OPENAI_API_KEY=
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=12h
# Comma-separated extra origins (https://jobhunter.dk and localhost:5173 are always allowed)
# ALLOWED_ORIGINS=

# Storage: "local" for dev without R2, "r2" for Cloudflare R2
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads

# Cloudflare R2 (when STORAGE_TYPE=r2)
# Opret bucket + API token i Cloudflare Dashboard → R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=career-intelligence
# Valgfrit — override endpoint (standard: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_ENDPOINT=

# Email OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/settings/email/callback/google
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/settings/email/callback/microsoft
ENCRYPTION_KEY=change-me-to-32-char-secret-key!!

PORT=3001
CLIENT_URL=http://localhost:5173
